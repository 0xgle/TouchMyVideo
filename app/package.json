{
  "name": "touchmyvideo",
  "version": "2.0.0",
  "description": "Download your own videos — beautifully.",
  "author": "Mateusz Glegoła <mat.glegola@gmail.com>",
  "homepage": "https://github.com/0xgle/touchmyvideo",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xgle/touchmyvideo.git"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build:react": "vite build",
    "build:electron": "electron-builder",
    "build": "npm run build:react && npm run build:electron",
    "build:win": "npm run build:react && electron-builder --win",
    "build:mac": "npm run build:react && electron-builder --mac",
    "build:linux": "npm run build:react && electron-builder --linux",
    "start": "electron .",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.touchmyvideo.app",
    "productName": "TouchMyVideo",
    "copyright": "Copyright © 2026 Mateusz Glegoła",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "TouchMyVideo",
        "schemes": [
          "touchmyvideo"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TouchMyVideo",
      "artifactName": "TouchMyVideo-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "TouchMyVideo-portable-${version}.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    }
  }
}
